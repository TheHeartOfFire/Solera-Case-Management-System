<Page x:Class="AMFormsCST.Desktop.Views.Pages.Tools.TemplatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AMFormsCST.Desktop.Views.Pages.Tools"
      xmlns:viewModels="clr-namespace:AMFormsCST.Desktop.ViewModels.Pages.Tools"
      xmlns:templateViewModels="clr-namespace:AMFormsCST.Desktop.ViewModels.Pages.Tools.Templates"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:AMFormsCST.Desktop.Helpers"
      xmlns:converters="clr-namespace:AMFormsCST.Desktop.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="Template Studio"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      d:DataContext="{d:DesignInstance Type=viewModels:TemplatesViewModel, IsDesignTimeCreatable=True}">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Page.Resources>

    <Grid Margin="14,10,14,14">
        <Grid.RowDefinitions>
            <!-- Top Studio Navigation / Header -->
            <RowDefinition Height="Auto" />
            <!-- 3-Column Studio Body -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Global Actions Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="MailTemplate24" FontSize="22" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Template Studio &amp; Assembly Engine" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Organize, compose, and manage modular templates for Salesforce, FormGen, and Emails"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="30,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Command="{Binding AddTemplateCommand}"
                           Appearance="Primary"
                           Content="New Template"
                           Icon="{ui:SymbolIcon Add24}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="0,0,6,0"
                           Padding="12,6"
                           ToolTip="Create a new template or partial"/>

                <ui:Button Command="{Binding ImportTemplateCommand}"
                           Appearance="Secondary"
                           Padding="10,6"
                           ToolTip="Import templates from JSON file">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Import" FontSize="12"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- 3-Column Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Template Taxonomy & Explorer -->
                <ColumnDefinition Width="280" MinWidth="220" />
                <ColumnDefinition Width="8" />
                <!-- Column 1: Template Composer & Variable Inserter -->
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="8" />
                <!-- Column 2: Live Assembly Tester & Preview -->
                <ColumnDefinition Width="340" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Template Taxonomy & Explorer -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search and Filters -->
                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,8">
                        <ui:TextBox PlaceholderText="Search templates &amp; partials..." 
                                    Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" 
                                    ClearButtonEnabled="True"
                                    Margin="0,0,0,6"/>

                        <!-- Where-Used / Tag Filter Pills -->
                        <ComboBox ItemsSource="{Binding TagFilterOptions}"
                                  SelectedItem="{Binding SelectedTagFilter}"
                                  Margin="0,0,0,6"
                                  ToolTip="Filter by Usage Tag"/>

                        <ComboBox ItemsSource="{Binding SortOptions}" 
                                  SelectedItem="{Binding SelectedSortOption}"
                                  Margin="0,0,0,4"/>
                    </StackPanel>

                    <!-- Templates List -->
                    <ui:DynamicScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox ItemsSource="{Binding TemplatesView}"
                                 SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type templateViewModels:TemplateItemViewModel}">
                                    <Border Margin="2,2,2,4" Padding="6,4">
                                        <StackPanel Orientation="Vertical">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Template.Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="1" Background="{DynamicResource AccentFillColorSecondaryBrush}" CornerRadius="4" Padding="4,1" Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding KindDisplayName}" FontSize="10" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding Template.Description, Mode=OneWay}"
                                                       TextWrapping="Wrap"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="0,2,0,0"
                                                       MaxHeight="36"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Text="{Binding TagsDisplay}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ui:DynamicScrollViewer>
                </Grid>
            </Border>

            <!-- GridSplitter 1 -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"
                          Cursor="SizeWE" />

            <!-- Column 1: Template Composer & Variable Inserter (Main Workspace) -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Metadata Row (Name, Kind, Action) -->
                        <RowDefinition Height="Auto" />
                        <!-- Tags Management Row -->
                        <RowDefinition Height="Auto" />
                        <!-- Variable Inserter Toolbar -->
                        <RowDefinition Height="Auto" />
                        <!-- Content Editor -->
                        <RowDefinition Height="*" />
                        <!-- Bottom Action Bar -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Metadata Row -->
                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,8">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,8,0">
                                <TextBlock Text="Template Name:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                <ui:TextBox Text="{Binding SelectedTemplate.Template.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Template Name"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <TextBlock Text="Classification Kind:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableCategoryKinds}"
                                          SelectedItem="{Binding SelectedTemplate.Kind, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>

                        <!-- Description -->
                        <ui:TextBox Text="{Binding SelectedTemplate.Template.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Template Description / Notes..."
                                    Margin="0,0,0,6"/>
                    </StackPanel>

                    <!-- Assigned Tags Row -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Tags:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                            <ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedTemplate.Tags}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="0,0,4,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ui:Button Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           Appearance="Transparent"
                                                           Padding="1">
                                                    <ui:SymbolIcon Symbol="Dismiss12" FontSize="9"/>
                                                </ui:Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add Tag Input -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:TextBox Text="{Binding NewTagInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="#tag"
                                            Width="80"
                                            Margin="0,0,4,0"/>
                                <ui:Button Command="{Binding AddTagCommand}"
                                           Content="+ Tag"
                                           Appearance="Secondary"
                                           Padding="6,3"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Variable Inserter Toolbar -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="0,0,0,8">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Insert Variable (Click to add):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding VariableTokens}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Command="{Binding DataContext.InsertVariableTokenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Appearance="Secondary"
                                                   Margin="0,0,4,3"
                                                   Padding="6,2">
                                            <TextBlock Text="{Binding}" FontSize="11" FontFamily="Cascadia Mono, Consolas"/>
                                        </ui:Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Template Content RichTextBox -->
                    <ui:RichTextBox Grid.Row="3"
                                    helpers:RichTextBoxHelper.Document="{Binding SelectedTemplate.Output, Mode=OneWay}"
                                    Margin="0,0,0,8"
                                    VerticalScrollBarVisibility="Auto"
                                    IsReadOnly="False"
                                    AcceptsReturn="True"/>

                    <!-- Bottom Action Controls -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Command="{Binding EditTemplateCommand}"
                                       Content="Full Editor Dialog"
                                       Appearance="Secondary"
                                       Margin="0,0,6,0"
                                       Padding="10,4"/>
                            <ui:Button Command="{Binding RemoveTemplateCommand}"
                                       Content="Delete"
                                       Appearance="Transparent"
                                       Padding="10,4"/>
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Command="{Binding SaveTemplateChangesCommand}"
                                   Appearance="Primary"
                                   Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="16" Margin="0,0,4,0"/>
                                <TextBlock Text="Save Template" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- GridSplitter 2 -->
            <GridSplitter Grid.Column="3"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"
                          Cursor="SizeWE" />

            <!-- Column 2: Live Assembly Tester & Preview -->
            <Border Grid.Column="4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Preview Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Live Assembly Test" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Rendered dynamically with active case" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Command="{Binding RefreshLivePreviewCommand}"
                                   Appearance="Transparent"
                                   ToolTip="Refresh preview">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16"/>
                        </ui:Button>
                    </Grid>

                    <!-- Live Rendered Preview Output -->
                    <ui:TextBox Grid.Row="1"
                                Text="{Binding LivePreviewText, Mode=OneWay}"
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                FontFamily="Cascadia Mono, Consolas, Courier New"
                                FontSize="12"
                                Margin="0,0,0,10"/>

                    <!-- Action Bar -->
                    <Grid Grid.Row="2">
                        <ui:Button Command="{Binding CopyTemplateCommand}"
                                   Appearance="Primary"
                                   HorizontalAlignment="Stretch"
                                   Padding="12,8"
                                   ToolTip="Copy rendered test output to clipboard">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Copy24" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Test Copy Output" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

