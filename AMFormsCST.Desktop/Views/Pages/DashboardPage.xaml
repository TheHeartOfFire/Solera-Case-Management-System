<Page x:Class="AMFormsCST.Desktop.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AMFormsCST.Desktop.Views.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
      xmlns:viewModels="clr-namespace:AMFormsCST.Desktop.ViewModels.Pages"
      xmlns:controls="clr-namespace:AMFormsCST.Desktop.Controls"
      xmlns:dashboard="clr-namespace:AMFormsCST.Desktop.Controls.Dashboard"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1200"
      Title="DashboardPage"
      d:DataContext="{d:DesignInstance viewModels:DashboardViewModel, IsDesignTimeCreatable=true}"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.CanContentScroll="False">

    <Grid x:Name="OutermostGrid" Margin="10,4,10,10">
        <Grid.RowDefinitions>
            <!-- Top Case Tab Bar & Quick Tools -->
            <RowDefinition Height="Auto" />
            <!-- Case Header -->
            <RowDefinition Height="Auto" />
            <!-- Progressive Disclosure 2-Pane Body -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar: Case Tabs + Quick Tool Buttons -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Case Tabs Selector -->
            <controls:ManagedObservableCollectionSelector Grid.Column="0"
                                                         ItemsSource="{Binding Notes}" 
                                                         RadioButtonCommand="{Binding NoteClickedCommand}" 
                                                         CommandParameterPath="Id"
                                                         ContentBindingPath="CaseNumber"
                                                         ContentFallbackValue="Enter a Case Number..."
                                                         GroupName="CaseNumbers"
                                                         RefreshTrigger="{Binding UiRefreshCounter}"
                                                         DeleteCommand="{Binding DeleteItemClickedCommand}"
                                                         ToolTip="Select, add, or delete a case note."
                                                         NextCommand="{Binding SelectNextNoteCommand}"
                                                         PreviousCommand="{Binding SelectPreviousNoteCommand}"/>

            <!-- Quick Action Toolbar Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <ui:Button Margin="0,0,6,0" Command="{Binding OpenTemplateDialogCommand}" ToolTip="Open Template Studio" Appearance="Secondary" Padding="8">
                    <ui:SymbolIcon Symbol="MailTemplate24" FontSize="20" />
                </ui:Button>
                <ui:Button Margin="0,0,6,0" Command="{Binding OpenCodeSnippetDialogCommand}" ToolTip="Open Code Snippets" Appearance="Secondary" Padding="8">
                    <ui:SymbolIcon Symbol="Code20" FontSize="20"/>
                </ui:Button>
                <ui:Button Margin="0,0,6,0" Command="{Binding OpenFormgenUtilsDialogCommand}" ToolTip="Open FormGen Utilities" Appearance="Secondary" Padding="8">
                    <ui:SymbolIcon Symbol="DocumentTextToolbox24" FontSize="20"/>
                </ui:Button>
                <ui:Button Command="{Binding LoadCaseCommand}" ToolTip="Import / Paste Case from Clipboard" Appearance="Secondary" Padding="8">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20"/>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Case Header (Case #, Server, Dealership, Contact, Expandable Details Tray) -->
        <dashboard:CaseHeaderControl Grid.Row="1" />

        <!-- 2-Pane Progressive Disclosure Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left: The Workpad / Composer -->
                <ColumnDefinition Width="420" MinWidth="340" />
                <ColumnDefinition Width="8" />
                <!-- Right: Output Preview & Action Timeline -->
                <ColumnDefinition Width="*" MinWidth="450" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Work Item Composer -->
            <dashboard:WorkItemComposerControl Grid.Column="0" />

            <!-- Grid Splitter for Flexible Resizing -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"
                          Cursor="SizeWE" />

            <!-- Right Pane: Live Output Preview & Case Action Timeline -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="180" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="4*" MinHeight="180" />
                </Grid.RowDefinitions>

                <!-- Upper Right: Assembled Output Generator & Preview -->
                <dashboard:AssembledOutputControl Grid.Row="0" />

                <!-- Splitter between preview and timeline -->
                <GridSplitter Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              ShowsPreview="True"
                              Cursor="SizeNS" />

                <!-- Lower Right: Case Action Timeline -->
                <dashboard:CaseActionTimelineControl Grid.Row="2" />
            </Grid>
        </Grid>
    </Grid>
</Page>