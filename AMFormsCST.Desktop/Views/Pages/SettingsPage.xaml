<Page
    x:Class="AMFormsCST.Desktop.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:AMFormsCST.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AMFormsCST.Desktop.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewmodels="clr-namespace:AMFormsCST.Desktop.ViewModels.Pages"
    Title="SettingsPage"
    d:DataContext="{d:DesignInstance viewmodels:SettingsViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">

            <!--  Personalization Section  -->
            <ui:Card Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Personalization" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Customize the look and feel of the application."
                        TextWrapping="Wrap" />

                    <TextBlock FontWeight="Medium" Text="Application Theme" />
                    <RadioButton
                        Margin="0,4,0,0"
                        Content="Light"
                        GroupName="theme"
                        IsChecked="{Binding CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light}" />
                    <RadioButton
                        Margin="0,4,0,0"
                        Content="Dark"
                        GroupName="theme"
                        IsChecked="{Binding CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark}" />

                    <ui:ToggleSwitch
                        Margin="0,12,0,0"
                        Content="Always on Top"
                        IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" />
                </StackPanel>
            </ui:Card>

            <!--  Behavior Section  -->
            <ui:Card Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Behavior" />

                    <ui:ToggleSwitch
                        Content="Automatically select new templates"
                        IsChecked="{Binding SelectNewTemplate, Mode=TwoWay}"
                        Margin="0,0,0,12" />

                    <ui:ToggleSwitch
                        Content="Capitalize form code in notes"
                        IsChecked="{Binding CapitalizeFormCode, Mode=TwoWay}"
                        Margin="0,0,0,12" />

                    <TextBlock Text="Phone Extension Separator" />
                    <ui:TextBox
                        Margin="0,4,0,0"
                        PlaceholderText="e.g., x"
                        Text="{Binding ExtSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </ui:Card>

            <!--  Windows Integration Section  -->
            <ui:Card Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Windows Integration" />

                    <ui:ToggleSwitch
                        Content="Enable Windows Explorer context menu for .formgen files"
                        IsChecked="{Binding EnableExplorerContextMenu, Mode=TwoWay}"
                        Margin="0,0,0,4" />

                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Adds 'Open in Solera Formgen Utilities' to the right-click menu of .formgen files."
                        TextWrapping="Wrap" />

                    <ui:ToggleSwitch
                        Content="Enable Shift + Right-Click Quick-Paste Flyout across external apps (Applies immediately)"
                        IsChecked="{Binding EnableShiftRightClickFlyout, Mode=TwoWay}"
                        Margin="0,0,0,12" />

                    <TextBlock Text="FormGen Executable / Batch Path (Optional)" Margin="0,4,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            Grid.Column="0"
                            PlaceholderText="C:\Users\...\AppData\Roaming\NewFormGen\NewFormGen.bat"
                            Text="{Binding FormGenExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Content="Browse..."
                            Command="{Binding BrowseFormGenExecutableCommand}" />
                    </Grid>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock FontWeight="Medium" Text="Default File Association (.formgen / .fga)" />
                        <TextBlock
                            Margin="0,2,0,8"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding FormgenAssociationStatus}"
                            TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal">
                            <ui:Button
                                Content="Associate with FormGen"
                                Appearance="Primary"
                                Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                Command="{Binding AssociateFormGenCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!--  FormGen Modifications & Patching Section  -->
            <ui:Card Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="FormGen Modifications &amp; Patching" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Deploy or remove the Solera FormGen integration payload and toggle individual FormGen features. Unpatching removes all traces of modification while remembering your toggle preferences."
                        TextWrapping="Wrap" />

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock FontWeight="Medium" Text="FormGen Payload Status" />
                        <TextBlock
                            Margin="0,2,0,8"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding FormGenPatchStatus}"
                            TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,8"
                                Content="Patch FormGen"
                                Appearance="Primary"
                                Icon="{ui:SymbolIcon Wrench24}"
                                Command="{Binding PatchFormGenCommand}" />
                            <ui:Button
                                Margin="0,0,8,8"
                                Content="Unpatch FormGen"
                                Appearance="Secondary"
                                Icon="{ui:SymbolIcon ArrowUndo24}"
                                Command="{Binding UnpatchFormGenCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock
                        Margin="0,2,0,2"
                        FontWeight="Medium"
                        Text="Individual FormGen Feature Toggles" />
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Toggling any feature below immediately enables or removes all traces of that feature in a running FormGen session without requiring a restart (except where noted)."
                        TextWrapping="Wrap" />

                    <StackPanel IsEnabled="{Binding IsFormGenPatched}">
                        <ui:ToggleSwitch
                            Margin="0,0,0,8"
                            Content="Preserve Code Window (UdfDlg) tab selection on Push &amp; form switch (Applies live)"
                            IsChecked="{Binding FormGenPreserveUdfTab, Mode=TwoWay}" />

                        <ui:ToggleSwitch
                            Margin="0,0,0,8"
                            Content="Right-click empty form canvas to paste Code Block as new Text / Numeric field (Applies live)"
                            IsChecked="{Binding FormGenCanvasPasteField, Mode=TwoWay}" />

                        <ui:ToggleSwitch
                            Margin="0,0,0,8"
                            Content="Focus existing tab &amp; show non-intrusive toast when opening an already-open file (Applies live)"
                            IsChecked="{Binding FormGenAlreadyOpenToast, Mode=TwoWay}" />

                        <ui:ToggleSwitch
                            Margin="0,0,0,8"
                            Content="Inject Solera Tools &amp; Quick Paste into FormGen right-click menus (Applies live)"
                            IsChecked="{Binding FormGenContextMenus, Mode=TwoWay}" />

                        <ui:ToggleSwitch
                            Margin="0,0,0,8"
                            Content="Enable multi-step Undo / Redo (Ctrl+Z / Ctrl+Y) in Code &amp; Prompt editors (Applies live)"
                            IsChecked="{Binding FormGenEditorUndoRedo, Mode=TwoWay}" />

                        <ui:ToggleSwitch
                            Margin="0,0,0,8"
                            Content="Add '⚡ Fill from Solera CMS' &amp; helper buttons to FormGen dialogs (Applies live — removes buttons immediately when off)"
                            IsChecked="{Binding FormGenDialogAutoFill, Mode=TwoWay}" />

                        <ui:ToggleSwitch
                            Margin="0,0,0,4"
                            Content="Auto-restore previously open forms (Takes effect when FormGen starts or reloads; turning off clears saved session immediately)"
                            IsChecked="{Binding FormGenAutoRestoreForms, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!--  Browser Integration Section  -->
            <ui:Card Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Browser Integration" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Integrate Solera CMS with Opera GX, Microsoft Edge, and Chrome for right-click FormGen code block parsing and live dashboard paste."
                        TextWrapping="Wrap" />

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock FontWeight="Medium" Text="Native Messaging Bridge" />
                        <TextBlock
                            Margin="0,2,0,8"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding BrowserBridgeStatus}"
                            TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,8"
                                Content="Register Bridge"
                                Appearance="Primary"
                                Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                Command="{Binding RegisterBrowserBridgeCommand}" />
                            <ui:Button
                                Margin="0,0,8,8"
                                Content="Remove Bridge"
                                Appearance="Secondary"
                                Icon="{ui:SymbolIcon Delete24}"
                                Command="{Binding RemoveBrowserBridgeCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock Margin="0,4,0,4" FontWeight="Medium" Text="Launch Browser with Extension" />
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="One-click setup: registers native messaging and launches your browser with the extension automatically loaded."
                        TextWrapping="Wrap" />

                    <WrapPanel Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,8"
                            Content="Install in Opera GX"
                            Appearance="Secondary"
                            Icon="{ui:SymbolIcon Globe24}"
                            Command="{Binding LaunchOperaGXExtensionCommand}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Content="Install in Microsoft Edge"
                            Appearance="Secondary"
                            Icon="{ui:SymbolIcon Globe24}"
                            Command="{Binding LaunchEdgeExtensionCommand}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Content="Install in Chrome"
                            Appearance="Secondary"
                            Icon="{ui:SymbolIcon Globe24}"
                            Command="{Binding LaunchChromeExtensionCommand}" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <!--  About Section  -->
            <ui:Card Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="About" />
                    <TextBlock
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding AppVersion}" />

                    <WrapPanel Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,8"
                            Command="{Binding CheckForUpdatesCommand}"
                            Appearance="Primary"
                            Content="Check for updates"
                            Icon="{ui:SymbolIcon ArrowDownload24}" />

                        <ui:Button
                            Margin="0,0,8,8"
                            Content="Report a Bug"
                            Command="{Binding ReportBugCommand}"
                            Icon="{ui:SymbolIcon Bug24}" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>