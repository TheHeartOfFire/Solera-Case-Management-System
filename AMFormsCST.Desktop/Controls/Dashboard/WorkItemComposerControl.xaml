<UserControl x:Class="AMFormsCST.Desktop.Controls.Dashboard.WorkItemComposerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:AMFormsCST.Desktop.Converters"
             xmlns:coreNotebook="clr-namespace:AMFormsCST.Core.Types.Notebook;assembly=AMFormsCST.Core"
             mc:Ignorable="d" 
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             d:DesignWidth="500">
    <UserControl.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBoolConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            VerticalAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Vertical">
                <!-- Card Header -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Edit24" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Work Item" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PDF" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ui:ToggleSwitch IsChecked="{Binding ComposerIsImpact, Mode=TwoWay}" ToolTip="Toggle PDF / Impact"/>
                        <TextBlock Text="Impact" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Form Name + Generator Magic Wand -->
                <TextBlock Text="Target Form:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0"
                                Text="{Binding ComposerFormName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="e.g. F102 - Buyers Order - Retail"
                                ClearButtonEnabled="True"
                                Margin="0,0,6,0"
                                ToolTip="Name or number of the form being modified"/>
                    <ui:Button Grid.Column="1"
                               Command="{Binding OpenFormNameGeneratorDialogCommand}"
                               Appearance="Secondary"
                               ToolTip="Open Form Name Generator (Best Practice Naming)">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Wand24" FontSize="16" Margin="0,0,4,0"/>
                            <TextBlock Text="Magic" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </Grid>

                <!-- Dealer Request / Misc Notes -->
                <TextBlock Text="Dealer Request / Misc Notes:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ui:TextBox Text="{Binding DealerRequestNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="56"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto"
                            PlaceholderText="What the dealer asked for, call context, or misc request notes..."
                            Margin="0,0,0,12"/>

                <!-- Tags Selector Pills (Compact Multi-Select + Inline New Tag) -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Work Tags:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBox Text="{Binding NewComposerTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="+ tag..."
                                    FontSize="11"
                                    Padding="6,2"
                                    MinHeight="24"
                                    Width="105"
                                    Margin="0,0,4,0">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddComposerTagCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <ui:Button Command="{Binding AddComposerTagCommand}"
                                   Content="+"
                                   FontSize="11"
                                   Padding="7,2"
                                   MinHeight="24"
                                   Appearance="Secondary"
                                   ToolTip="Add custom tag"/>
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding AvailableComposerTags}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding Tag}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Margin="0,0,4,4"
                                          Padding="8,2"
                                          MinWidth="0"
                                          MinHeight="22"
                                          FontSize="11">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="10"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Notes / Details Textarea -->
                <TextBlock Text="Change Details / Notes:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ui:TextBox Text="{Binding ComposerDetails, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="145"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto"
                            PlaceholderText="Describe the changes made (e.g. Shifted lines 14-16 down 2pt for dot matrix alignment)..."
                            Margin="0,0,0,12"/>

                <!-- Collapsible Stores & Multi-Deals Section (Progressive Disclosure) -->
                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,14">
                    <StackPanel Orientation="Vertical">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Command="{Binding ToggleAdvancedStoresDealsCommand}"
                                       Appearance="Transparent"
                                       HorizontalAlignment="Left"
                                       Padding="0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ChevronDown24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Stores &amp; Test Deals" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ComposerStoresSummary, StringFormat='{} ({0})'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </ui:Button>
                            <CheckBox Grid.Column="1"
                                      Content="Custom Copy"
                                      IsChecked="{Binding ComposerIsCustomCopy, Mode=TwoWay}"
                                      FontSize="11"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Expanded Tray for Stores and Deals -->
                        <StackPanel Visibility="{Binding IsAdvancedStoresDealsExpanded, Converter={StaticResource BoolToVisConverter}}" Margin="0,10,0,0">
                            <!-- Store Pills -->
                            <TextBlock Text="Assign to Specific Stores (Click to toggle):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding SelectedNote.SelectedDealer.Companies}" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Command="{Binding DataContext.ToggleComposerStoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding CompanyCode}"
                                                   Appearance="Secondary"
                                                   Margin="0,0,6,4"
                                                   Padding="8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CompanyCode}" FontWeight="Bold" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11"/>
                                            </StackPanel>
                                        </ui:Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Multi-Deals Section -->
                            <TextBlock Text="Test Deals:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            
                            <!-- Deal Chips List -->
                            <ItemsControl ItemsSource="{Binding ComposerDeals}" Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AccentFillColorSecondaryBrush}" CornerRadius="10" Margin="0,0,4,4" Padding="6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ui:Button Command="{Binding DataContext.RemoveComposerDealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"
                                                           Appearance="Transparent"
                                                           Padding="2"
                                                           ToolTip="Remove Deal">
                                                    <ui:SymbolIcon Symbol="Dismiss12" FontSize="10"/>
                                                </ui:Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add Deal Input Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            Text="{Binding NewDealNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Deal #"
                                            Margin="0,0,4,0"/>
                                <ui:TextBox Grid.Column="1"
                                            Text="{Binding NewDealPurpose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Purpose (e.g. Retail, Store 07)"
                                            Margin="0,0,4,0"/>
                                <ui:Button Grid.Column="2"
                                           Command="{Binding AddComposerDealCommand}"
                                           Content="+ Deal"
                                           Appearance="Secondary"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Primary Post / Update Button -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0"
                               Command="{Binding PostLogEntryCommand}"
                               Appearance="Primary"
                               Content="{Binding PostLogButtonText}"
                               Icon="{ui:SymbolIcon Add24}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               HorizontalAlignment="Stretch"
                               Padding="16,10"
                               ToolTip="Post this work item to the active case action timeline"/>
                    <ui:Button Grid.Column="1"
                               Command="{Binding CancelEditLogEntryCommand}"
                               Content="Cancel"
                               Appearance="Secondary"
                               Visibility="{Binding IsEditingLogEntry, Converter={StaticResource BoolToVisConverter}}"
                               Margin="8,0,0,0"
                               Padding="14,10"
                               ToolTip="Cancel editing this timeline entry"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>

