<UserControl x:Class="AMFormsCST.Desktop.Controls.Dashboard.CaseHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:AMFormsCST.Desktop.Controls"
             xmlns:converters="clr-namespace:AMFormsCST.Desktop.Converters"
             mc:Ignorable="d" 
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,10"
            Margin="0,0,0,10">
        <StackPanel Orientation="Vertical">
            <!-- Compact Header Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Case # -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="20" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <Label Content="Case #:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ui:TextBox Text="{Binding SelectedNote.CaseNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="00000000"
                                MinWidth="110"
                                VerticalAlignment="Center"
                                ClearButtonEnabled="True"
                                ToolTip="Case number"/>
                    <controls:CopyButton TextToCopy="{Binding SelectedNote.CaseNumber}" Margin="4,0,0,0" ToolTip="Copy Case Number"/>
                </StackPanel>

                <!-- Server, Dealership, Contact -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Server ID -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                        <Label Content="Server:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ui:TextBox Text="{Binding SelectedNote.SelectedDealer.ServerCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="SVR1"
                                    MinWidth="96"
                                    ClearButtonEnabled="False"
                                    VerticalAlignment="Center"
                                    ToolTip="Server ID"/>
                        <controls:CopyButton TextToCopy="{Binding SelectedNote.SelectedDealer.ServerCode}" Margin="4,0,0,0" ToolTip="Copy Server ID"/>
                    </StackPanel>

                    <!-- Dealership -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                        <Label Content="Dealer:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ui:TextBox Text="{Binding SelectedNote.SelectedDealer.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Dealership Name"
                                    MinWidth="160"
                                    VerticalAlignment="Center"
                                    ToolTip="Dealership / Group Name"/>
                        <controls:CopyButton TextToCopy="{Binding SelectedNote.SelectedDealer.Name}" Margin="4,0,0,0" ToolTip="Copy Dealership Name"/>
                    </StackPanel>

                    <!-- Primary Contact -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                        <ui:SymbolIcon Symbol="Person24" FontSize="18" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <ui:TextBox Text="{Binding SelectedNote.SelectedContact.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    LostFocus="ContactName_LostFocus"
                                    PlaceholderText="Contact Name"
                                    MinWidth="130"
                                    VerticalAlignment="Center"
                                    ToolTip="Primary Contact Name"/>
                        <ui:TextBox Text="{Binding SelectedNote.SelectedContact.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Email"
                                    MinWidth="150"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Contact Email"/>
                        <ui:TextBox Text="{Binding SelectedNote.SelectedContact.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Phone"
                                    Width="110"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Contact Phone"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Right Side: Expandable Badges & Details Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8,4"
                            Margin="0,0,6,0"
                            ToolTip="Linked Cases count">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Link24" FontSize="14" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding SelectedNote.LinkedCases.Count, StringFormat='{}{0} Linked'}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8,4"
                            Margin="0,0,8,0"
                            ToolTip="Stores / Companies count">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Building24" FontSize="14" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding SelectedNote.SelectedDealer.Companies.Count, StringFormat='{}{0} Stores'}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Expand/Collapse Details Button -->
                    <ui:Button Command="{Binding ToggleHeaderDetailsCommand}"
                               Appearance="Secondary"
                               Padding="8,4"
                               ToolTip="Toggle Linked Cases, Contact Roster, and Store Directory">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Navigation24" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="Details" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- Collapsible Advanced Details Tray (Linked Cases, Contacts, Stores) -->
            <Border Visibility="{Binding IsHeaderDetailsExpanded, Converter={StaticResource BoolToVisConverter}}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,10,0,0"
                    Padding="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <!-- Column 0: Linked Cases Manager -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="🔗 LINKED CASES" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        
                        <ItemsControl ItemsSource="{Binding SelectedNote.LinkedCases}" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource AccentFillColorSecondaryBrush}" CornerRadius="10" Margin="0,0,4,4" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold"/>
                                            <ui:Button Command="{Binding DataContext.RemoveLinkedCaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       Appearance="Transparent"
                                                       Padding="2"
                                                       ToolTip="Remove linked case">
                                                <ui:SymbolIcon Symbol="Dismiss12" FontSize="10"/>
                                            </ui:Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Linked Case input -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding NewLinkedCaseNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Case # to link..."
                                        Margin="0,0,4,0"/>
                            <ui:Button Grid.Column="1"
                                       Command="{Binding AddLinkedCaseCommand}"
                                       Content="+ Link"
                                       Appearance="Secondary"/>
                        </Grid>
                    </StackPanel>

                    <!-- Column 1: Contacts & Stakeholders Roster -->
                    <StackPanel Grid.Column="1" Margin="6,0,12,0">
                        <TextBlock Text="👥 CONTACTS &amp; STAKEHOLDERS" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding SelectedNote.Contacts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsPrimary, Mode=TwoWay}" ToolTip="Primary POC" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <ui:TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostFocus="ContactName_LostFocus" PlaceholderText="Name" Margin="0,0,4,0"/>
                                            <ui:TextBox Grid.Column="2" Text="{Binding Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Role / Title" Margin="0,0,4,0"/>
                                            <ui:TextBox Grid.Column="3" Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Notes (e.g. Off Fridays)"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Column 2: Dealership Stores Directory -->
                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                        <TextBlock Text="🏢 STORES &amp; COMPANIES" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding SelectedNote.SelectedDealer.Companies}" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding CompanyCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Co#" Margin="0,0,4,0"/>
                                        <ui:TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Store Name" Margin="0,0,4,0"/>
                                        <CheckBox Grid.Column="2" IsChecked="{Binding Notable, Mode=TwoWay}" ToolTip="Notable" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Comma-Separated Company #s -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding NewCompanyCodes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Co#s (e.g. 01, 02, 04)..."
                                        Margin="0,0,4,0"
                                        ToolTip="Type or paste comma-separated company numbers">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddCompaniesCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                            <ui:Button Grid.Column="1"
                                       Command="{Binding AddCompaniesCommand}"
                                       Content="+ Add"
                                       Appearance="Secondary"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
