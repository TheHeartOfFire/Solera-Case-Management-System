{
  "manifest_version": 3,
  "name": "Solera CMS & Project Citadel Assistant",
  "version": "1.0.0",
  "description": "Context menu integration bridging Salesforce with Solera Case Management System and Project Citadel.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.lightning.force.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.force.com/*",
        "https://*.lightning.force.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

